# =====================================================================
#  Ride-Hailing Surge Analytics - configuration
#  ./start.sh copies this file to .env. Fill in the values marked >>> FILL IN <<<
#  (AWS, Databricks, Groq). Everything else has working defaults.
#  While a cloud key is empty, the Airflow tasks for that cloud show as "skipped".
# =====================================================================

# ---------------- General ----------------
CITY=NYC
TZ=UTC

# ---------------- Data (NYC TLC HVFHV) ----------------
# One month of High-Volume For-Hire Vehicle trips (published with ~2 month lag)
TLC_MONTH=2025-01
# The month has ~20M rows. We load a uniform sample across the whole month into MySQL
# so a 8-16 GB laptop can cope. Raise it if you have the RAM (e.g. 3000000).
SEED_MAX_ROWS=2000000
N_DRIVERS=5000
N_RIDERS=50000

# ---------------- MySQL (operational source) ----------------
MYSQL_ROOT_PASSWORD=rootpass
MYSQL_DATABASE=ridehail
MYSQL_USER=etl
MYSQL_PASSWORD=etlpass

# ---------------- Live replay / simulators ----------------
# Day of the TLC month that is replayed as live trip requests (must be inside TLC_MONTH)
REPLAY_DAY=2025-01-15
# Start the replay at this wall-clock time of the replay day (rush hour is more interesting)
REPLAY_START_TIME=07:30
# 1 = real time, 10 = ten times faster
REPLAY_SPEED=1
# Fraction of the real trip requests that are replayed (HVFHV ~700k trips/day)
REPLAY_SAMPLE_RATE=0.06
# Driver fleet simulated by the GPS simulator (ids 1..FLEET_SIZE, must be <= N_DRIVERS)
FLEET_SIZE=700
GPS_PING_MIN_SEC=15
GPS_PING_MAX_SEC=30
# Custom Scala producer (make scala-producer): its own driver fleet, ids FLEET_SIZE+1 .. FLEET_SIZE+SCALA_FLEET_SIZE
SCALA_FLEET_SIZE=100
# CityBikes network id (the public id is citi-bike-nyc) and how much a free bike counts as supply
CITYBIKES_NETWORK=citi-bike-nyc
CITYBIKES_SUPPLY_WEIGHT=0.01
CITYBIKES_POLL_SEC=60
WEATHER_POLL_SEC=60
WEATHER_LAT=40.7128
WEATHER_LON=-74.0060

# ---------------- Streaming engine ----------------
STREAM_DRIVER_MEMORY=1g
RAIN_SURGE_THRESHOLD_MM=2.5

# ---------------- Airflow / email (MailHog = local inbox, no credentials) ----------------
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=admin
ALERT_EMAIL=ops@ridehail.local
REPORT_EMAIL=ops@ridehail.local
# Defaults send mail to the MailHog container (UI: http://localhost:8026, MAILHOG_UI_PORT below)
SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=False
SMTP_SSL=False
SMTP_MAIL_FROM=surge-analytics@ridehail.local

# ---------------- AWS (S3 + Glue + Athena) ----------------
# >>> FILL IN <<<  (leave blank to skip the AWS steps)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
# >>> FILL IN <<<  globally unique bucket name; created automatically if it does not exist
S3_BUCKET=
GLUE_DATABASE=ridehail
# cost guards: Athena workgroup with a per-query scan limit + monthly AWS budget alert
ATHENA_WORKGROUP=ridehail
ATHENA_SCAN_LIMIT_MB=1024
AWS_BUDGET_USD=5
# optional: e-mail for the AWS budget alert (leave blank to skip)
BUDGET_ALERT_EMAIL=

# ---------------- Databricks (Bronze / Silver / Gold with Delta Live Tables) ----------------
# >>> FILL IN <<<  host = https://dbc-xxxxxxxx-xxxx.cloud.databricks.com   token = Settings > Developer > Access tokens
# http path = SQL Warehouses > (your warehouse) > Connection details   (Gold is read through the SQL warehouse)
DATABRICKS_HOST=
DATABRICKS_TOKEN=
DATABRICKS_HTTP_PATH=
DATABRICKS_CATALOG=workspace
DATABRICKS_SCHEMA=ridehail

# ---------------- GenAI Ops assistant (Groq) ----------------
# >>> FILL IN <<<
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# ---------------- Host ports (change if something on your PC already uses one) ----------------
MYSQL_HOST_PORT=3307
AIRFLOW_PORT=8080
NAMENODE_UI_PORT=9870
HBASE_UI_PORT=16010
GENAI_PORT=8501
MAILHOG_UI_PORT=8026
