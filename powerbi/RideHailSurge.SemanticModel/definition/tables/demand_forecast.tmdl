		annotation SummarizationSetBy = Automatic

	partition demand_forecast = m
		mode: import
		source =
				let
				    Source =
				        Databricks.Catalogs(DatabricksHost, DatabricksHttpPath, [Catalog=null, Database=null, EnableAutomaticProxyDiscovery=null]){[Name=DatabricksCatalog, Kind="Database"]}[Data]{[Name=DatabricksSchema, Kind="Schema"]}[Data]{[Name="demand_forecast", Kind="Table"]}[Data],
				    Selected = Table.SelectColumns(Source, {"zone_id", "forecast_ts", "predicted_demand", "actual_demand", "model_version", "scored_at", "mode"}, MissingField.UseNull),
				    Typed = Table.TransformColumnTypes(Selected, {{"zone_id", Int64.Type}, {"forecast_ts", type datetime}, {"predicted_demand", type number}, {"actual_demand", type number}, {"model_version", type text}, {"scored_at", type datetime}, {"mode", type text}}, "en-US")
				in
				    Typed

	annotation PBI_ResultType = Table
