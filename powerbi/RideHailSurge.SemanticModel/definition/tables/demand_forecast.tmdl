table demand_forecast
	lineageTag: 4c9895dd-49e8-5d0a-a73b-c3f570c268d8

	measure 'Forecast Demand' = CALCULATE ( SUM ( demand_forecast[predicted_demand] ), demand_forecast[mode] = "live" )
		formatString: #,0.0
		lineageTag: de63979e-2409-5ed1-b657-15c5bf3c610f

	measure 'Holdout Predicted' = CALCULATE ( SUM ( demand_forecast[predicted_demand] ), demand_forecast[mode] = "holdout" )
		formatString: #,0.0
		lineageTag: 178de4ad-6a8f-5e69-aa96-5187f738a524

	measure 'Holdout Actual' = CALCULATE ( SUM ( demand_forecast[actual_demand] ), demand_forecast[mode] = "holdout" )
		formatString: #,0.0
		lineageTag: 8653a70e-72e0-592b-8982-93bbd108bfe6

	measure 'Forecast Error (MAE)' =
			AVERAGEX (
			    FILTER ( demand_forecast, demand_forecast[mode] = "holdout" ),
			    ABS ( demand_forecast[predicted_demand] - demand_forecast[actual_demand] )
			)
		formatString: 0.00
		lineageTag: 625253f3-3c8c-57db-bed5-1c656b009874

	column zone_id
		dataType: int64
		formatString: 0
		lineageTag: e9cb3aa0-53e4-509a-9776-a6635a9f5e0d
		summarizeBy: none
		sourceColumn: zone_id

		annotation SummarizationSetBy = Automatic

