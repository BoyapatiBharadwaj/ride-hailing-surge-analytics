table zone_hourly_kpis
	lineageTag: 06eb6bfa-95c1-5f25-893c-cc9d26498d69

	measure 'Total Requests' = SUM ( zone_hourly_kpis[requests] )
		formatString: #,0
		lineageTag: 63d328b1-00dc-5396-89f3-720837e113d9

	measure 'Completed Trips' = SUM ( zone_hourly_kpis[completed_trips] )
		formatString: #,0
		lineageTag: 3ca5353d-0a09-54c4-b57a-93e16ea7d9fc

	measure 'Cancelled Trips' = SUM ( zone_hourly_kpis[cancelled_trips] )
		formatString: #,0
		lineageTag: a7eebb64-f78a-5b9e-848b-20d0bfebd919

	measure 'Cancellation Rate' = DIVIDE ( [Cancelled Trips], [Total Requests] )
		formatString: 0.0%
		lineageTag: 2557627a-fff3-59c1-881d-cf2ec915b857

	measure 'Total Revenue' = SUM ( zone_hourly_kpis[revenue] )
		formatString: $#,0
		lineageTag: 9230d2e9-a6a3-5e98-b5b9-6f09ac9e53bd

	measure 'Distance km' = SUM ( zone_hourly_kpis[distance_km] )
		formatString: #,0
		lineageTag: 6f8e98fb-d0f3-5368-9657-ed33c7fd6d0a

	measure 'Revenue per km' = DIVIDE ( [Total Revenue], [Distance km] )
		formatString: $#,0.00
		lineageTag: 7d17b20c-805f-5f87-a736-2aaaa7789e0d

	measure 'Avg Rider ETA (min)' =
			DIVIDE (
			    SUMX ( zone_hourly_kpis, zone_hourly_kpis[avg_eta_min] * zone_hourly_kpis[completed_trips] ),
			    CALCULATE ( SUM ( zone_hourly_kpis[completed_trips] ), NOT ISBLANK ( zone_hourly_kpis[avg_eta_min] ) )
			)
		formatString: 0.00
		lineageTag: 8577384d-490a-577f-acf0-2fe851eb105a

	measure 'ETA Target' = 4.5
		formatString: 0.0
		lineageTag: 1f451fe7-977a-58a5-9ed0-bc5790279812

	measure 'ETA vs Target' = [Avg Rider ETA (min)] - [ETA Target]
		formatString: +0.00;-0.00;0.00
		lineageTag: 0981ba9f-db1d-5e3a-89fb-fc1f89f2be67

	measure 'Avg Surge (hourly)' = AVERAGE ( zone_hourly_kpis[avg_surge] )
		formatString: 0.00x
		lineageTag: 14c50852-ce8c-5ff7-b34f-14e3ae9ff8c6

