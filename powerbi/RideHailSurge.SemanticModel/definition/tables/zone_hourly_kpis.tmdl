				    Selected = Table.SelectColumns(Source, {"zone_id", "hour_ts", "source", "requests", "completed_trips", "cancelled_trips", "avg_eta_min", "revenue", "distance_km", "avg_surge", "avg_supply"}, MissingField.UseNull),
				    Typed = Table.TransformColumnTypes(Selected, {{"zone_id", Int64.Type}, {"hour_ts", type datetime}, {"source", type text}, {"requests", Int64.Type}, {"completed_trips", Int64.Type}, {"cancelled_trips", Int64.Type}, {"avg_eta_min", type number}, {"revenue", type number}, {"distance_km", type number}, {"avg_surge", type number}, {"avg_supply", type number}}, "en-US")
