table driver_daily_utilisation
	lineageTag: f976a253-6266-5f6d-b262-88d08424b582

	measure 'Driver Utilisation' = DIVIDE ( SUM ( driver_daily_utilisation[on_trip_pings] ), SUM ( driver_daily_utilisation[pings] ) )
		formatString: 0.0%
		lineageTag: 7ddde855-c898-53c8-8b02-8293d7669c0f

	measure 'Utilisation Target' = 0.78
		formatString: 0%
		lineageTag: 7696c9c7-463f-505a-9139-accb5e035b0d

	measure 'Utilisation vs Target' = [Driver Utilisation] - [Utilisation Target]
		formatString: +0.0%;-0.0%;0.0%
		lineageTag: a136d2a6-87a7-5712-96d6-a2466690bee3

	measure 'Active Drivers' = DISTINCTCOUNT ( driver_daily_utilisation[driver_id] )
		formatString: #,0
		lineageTag: c0b33180-b5f2-51be-ab8d-f7b594684c95

