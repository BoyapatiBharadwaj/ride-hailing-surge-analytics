table zone_minute_surge
	lineageTag: 614b59f6-04f4-5736-8611-d11224e5f5bf

	measure 'Current Surge' =
			VAR lastMinute = CALCULATE ( MAX ( zone_minute_surge[minute_ts] ), ALL ( zone_minute_surge ) )
			RETURN CALCULATE ( AVERAGE ( zone_minute_surge[multiplier] ), zone_minute_surge[minute_ts] = lastMinute )
		formatString: 0.00x
		lineageTag: b6bc7bf3-0f63-5e3b-8e6f-f92b4b883928

	measure 'Current Demand/Supply Ratio' =
			VAR lastMinute = CALCULATE ( MAX ( zone_minute_surge[minute_ts] ), ALL ( zone_minute_surge ) )
			RETURN CALCULATE ( AVERAGE ( zone_minute_surge[ratio] ), zone_minute_surge[minute_ts] = lastMinute )
		formatString: 0.00
		lineageTag: 601b33f1-529e-5d97-ac4f-6cd9dfc46ba1

	measure 'Surging Zones Now' =
			VAR lastMinute = CALCULATE ( MAX ( zone_minute_surge[minute_ts] ), ALL ( zone_minute_surge ) )
			RETURN CALCULATE ( DISTINCTCOUNT ( zone_minute_surge[zone_id] ), zone_minute_surge[minute_ts] = lastMinute, zone_minute_surge[multiplier] > 1 )
		formatString: 0
		lineageTag: 180bf142-afc5-5d70-a6ce-6a0492755c56

	measure 'Max Surge' = MAX ( zone_minute_surge[multiplier] )
		formatString: 0.00x
		lineageTag: b455aabc-9db9-52ce-baa6-c3fbfa941915

	measure 'Max Surge Today' =
			MAXX (
			    FILTER ( zone_minute_surge, INT ( zone_minute_surge[minute_ts] ) = INT ( MAX ( zone_minute_surge[minute_ts] ) ) ),
			    zone_minute_surge[multiplier]
			)
		formatString: 0.00x
		lineageTag: 4dcde75e-cfab-5939-b2fa-75a52145589a

	measure 'Last Surge Refresh' = MAX ( zone_minute_surge[updated_at] )
		formatString: General Date
		lineageTag: d3e27bf5-3046-5012-8c62-4dd3e9254d6e

